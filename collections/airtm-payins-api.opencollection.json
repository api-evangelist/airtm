{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airtm Enterprise API V2 Payins API",
    "version": "1.155.0"
  },
  "items": [
    {
      "info": {
        "name": "Payins",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List payins",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.airtm.com/v2/payins",
            "params": [
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Gets results before the specified cursor."
              },
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Gets results after the specified cursor."
              },
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "The maximum number of items to fetch."
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "enterpriseId",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Endpoint to list all payins associated with your account."
        },
        {
          "info": {
            "name": "Create a Payin",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.enterprise.airtm.com/v2/payins",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "This endpoint will allow you to create a payin.\nIn order to complete a payin, it must first be created, then the user must be directed to the Airtm website to confirm/checkout the payin, at which time they will be redirected to a URL of your choosing. See “Usage” below.\n\nWe will redirect the user to either `confirmationUri` or `cancelUri` with code as a query parameter so you can process the payin as being either confirmed or cancelled.\n\n## Usage\n\n 1. Create a payin.\n 2. Extract the `id` from th"
        },
        {
          "info": {
            "name": "Get payin details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.airtm.com/v2/payins/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The payin id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get the details of an existing payin."
        },
        {
          "info": {
            "name": "Cancel a payin",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.enterprise.airtm.com/v2/payins/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The payin id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Cancel an existing payin.\n\n> [!tip]\n> Only `PENDING` payins can be canceled."
        },
        {
          "info": {
            "name": "Get payin by code",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.airtm.com/v2/payins/by-code/:code",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path",
                "description": "The payin code"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get the details of an existing payin by its code."
        }
      ]
    }
  ],
  "bundled": true
}