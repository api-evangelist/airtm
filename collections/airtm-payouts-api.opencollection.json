        {
          "info": {
            "name": "Create a payout",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.enterprise.airtm.com/v2/payouts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "This endpoint allows you to create a payout instruction. In the request body, information about\nthe payout such as the recipient's email, description, amount, and any URLs needed for confirmation\nor failure redirects should be provided.\n\nUpon successful creation, the API returns a response containing the details of the newly created\npayout, including a unique ID.\n\n> [!tip]\n> After making a call to this endpoint, no money is moved yet. To finish moving the money to a\n> user, you must call the `PO"
        },
        {
          "info": {
            "name": "Get a single payout",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.airtm.com/v2/payouts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The payout id"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
