{
  "opencollection": "1.0.0",
  "info": {
    "name": "Airtm Enterprise API V2 Me API",
    "version": "1.155.0"
  },
  "items": [
    {
      "info": {
        "name": "Me",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get enterprise details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.airtm.com/v2/me",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get enterprise details"
        },
        {
          "info": {
            "name": "Get balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.airtm.com/v2/me/balance",
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieves the current balance of the enterprise.\nIt will include both available and pending amounts.\n\n> [!tip]\n> The pending amount is the sum of all committed pending payouts."
        }
      ]
    }
  ],
  "bundled": true
}